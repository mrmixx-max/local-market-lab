# Local Market Lab environment
# All values optional — the lab runs fully offline on synthetic/imported data by default.

# Workspace directory for databases, caches, artifacts
LML_WORKSPACE=./data

# Reporting currency for aggregations (ISO code)
LML_REPORTING_CURRENCY=EUR

# Never set real API keys here — this file is a template only.
# External market-data providers are opt-in per adapter and carry license metadata.
